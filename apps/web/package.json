{
  "name": "@mscd/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:views": "node scripts/convert-template.mjs",
    "gen:views:check": "node scripts/check-views.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir test --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test -c playwright.api.config.js",
    "test:e2e:all": "node ../../tools/scripts/e2e-all.mjs",
    "export:sample": "node scripts/export-sample-snapshot.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mscd/shared": "*",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "htmlparser2": "^12.0.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
