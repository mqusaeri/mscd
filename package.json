{
  "name": "mscd",
  "private": true,
  "description": "MSCD (Management System Compliance Dashboard) platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int -w @mscd/server",
    "test:e2e": "npm run test:e2e -w @mscd/web",
    "test:e2e:api": "npm run test:e2e:api -w @mscd/web",
    "test:smoke": "npm run smoke -w @mscd/smoke",
    "openapi": "npm run openapi -w @mscd/shared",
    "dev:stack": "docker compose -f deploy/compose/dev/compose.yml up -d --wait",
    "seed:demo": "npm run seed:demo -w @mscd/server",
    "check:text": "node tools/scripts/check-text.mjs docs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "archiver-utils": {
      "glob": "14.0.3"
    },
    "exceljs": {
      "unzipper": "0.12.5"
    },
    "fastify": "5.12.7",
    "gcp-metadata": {
      "gaxios": "^7.1.4"
    },
    "minimatch": "11.0.3",
    "uuid": "11.1.1",
    "vite": "8.3.4"
  }
}
