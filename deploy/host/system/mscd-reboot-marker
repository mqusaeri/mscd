#!/bin/sh
# Managed by deploy/scripts/bootstrap-host.sh (docs/saas/bootstrap.md).
# Writes /opt/mscd/metrics/reboot.prom for the textfile collector of the
# node exporter (monitoring). Run by mscd-reboot-marker.timer.
#
#   mscd_host_reboot_required                           1 when installed updates need a reboot
#   mscd_host_reboot_required_since_timestamp_seconds   when that became true (0 when no reboot is needed)
set -eu

dir=${MSCD_METRICS_DIR:-/opt/mscd/metrics}
flag=${MSCD_REBOOT_FLAG:-/run/reboot-required}

[ -d "$dir" ] || exit 0

needed=0
since=0
if [ -e "$flag" ]; then
    needed=1
    since=$(stat -c %Y "$flag")
fi

tmp=$(mktemp "$dir/.reboot.prom.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<EOF
# HELP mscd_host_reboot_required 1 when installed updates need a reboot of the server.
# TYPE mscd_host_reboot_required gauge
mscd_host_reboot_required $needed
# HELP mscd_host_reboot_required_since_timestamp_seconds Time when a reboot became necessary, 0 when none is needed.
# TYPE mscd_host_reboot_required_since_timestamp_seconds gauge
mscd_host_reboot_required_since_timestamp_seconds $since
EOF
chmod 0644 "$tmp"
mv -f "$tmp" "$dir/reboot.prom"
trap - EXIT
